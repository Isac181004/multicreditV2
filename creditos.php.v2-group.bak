        <div class="p-6 space-y-4 text-sm text-gray-600 leading-relaxed">
            <p class="font-semibold text-gray-800 border-b pb-1">Para Personas Naturales o Negocios:</p>
            <ul class="space-y-2.5 list-none pl-0">
                <div class="flex items-start"><i class="fas fa-id-card text-brand-green mt-1 mr-3 text-xs"></i><li>Copia de DNI vigente (titular y cónyuge en caso aplique).</li></div>
                <div class="flex items-start"><i class="fas fa-receipt text-brand-green mt-1 mr-3 text-xs"></i><li>Recibo de servicios públicos (Luz o Agua) de tu domicilio actual.</li></div>
                <div class="flex items-start"><i class="fas fa-file-signature text-brand-green mt-1 mr-3 text-xs"></i><li>Documentos que acrediten tus ingresos (Boletas de compra, facturas, cuadernos de control o constancias).</li></div>
                <div class="flex items-start"><i class="fas fa-map-marker-alt text-brand-green mt-1 mr-3 text-xs"></i><li>Tener una antigüedad mínima de 6 meses operando tu negocio o actividad productiva en la región.</li></div>
            </ul>
            <div class="bg-orange-50 border-l-4 border-brand-orange p-3 rounded text-xs text-brand-orange mt-4">
                <i class="fas fa-exclamation-circle mr-1"></i> <strong>Sujeto a evaluación:</strong> Recuerda que tu asesor técnico de campo te visitará para darte las máximas facilidades de trámite.
            </div>
        </div>
        <div class="bg-gray-50 px-6 py-3 flex justify-end border-t">
            <button onclick="document.getElementById('panelRequisitos').classList.add('hidden')" class="bg-brand-green hover:bg-green-700 text-white text-xs font-bold py-2 px-5 rounded-lg transition shadow">Entendido</button>
        </div>
    </div>
</div>

<script src="js/app.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const $ = (id) => document.getElementById(id);
    const montoInput = $('monto-input');
    const montoSlider = $('monto-slider');
    const plazoInput = $('plazo-input');
    const plazoSlider = $('plazo-slider');
    const tasaInput = $('tasa-input');
    const tasaSlider = $('tasa-slider');

    let costChart = null;
    let balanceChart = null;
    let productoSeleccionado = 'Crédito';

    document.querySelectorAll('[data-producto]').forEach((link) => {
        link.addEventListener('click', () => {
            productoSeleccionado = link.getAttribute('data-producto') || 'Crédito';
        });
    });

    const money = (n) => 'S/ ' + Number(n || 0).toLocaleString('es-PE', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
    });

    function clamp(v, min, max) {
        return Math.min(max, Math.max(min, v));
    }

    function syncPair(input, slider, min, max, step) {
        input.addEventListener('input', () => {
            let value = parseFloat(input.value);
            if (!Number.isFinite(value)) return;
            value = clamp(value, min, max);
            slider.value = value;
            input.value = value;
            calcular();
        });
        slider.addEventListener('input', () => {
            input.value = slider.value;
            calcular();
        });
    }

    syncPair(montoInput, montoSlider, 500, 50000, 100);
    syncPair(plazoInput, plazoSlider, 1, 36, 1);
    syncPair(tasaInput, tasaSlider, 3.0, 4.0, 0.1);

    function calcular() {
        const P = Number(montoInput.value);
        const n = Number(plazoInput.value);
        const tasa = Number(tasaInput.value);
        const i = tasa / 100;

        if (!P || !n || !i) return;

        const cuota = P * (i * Math.pow(1 + i, n)) / (Math.pow(1 + i, n) - 1);
        const total = cuota * n;
        const intereses = total - P;

        $('cuota-display').textContent = money(cuota);
        $('capital-display').textContent = money(P);
        $('interes-display').textContent = money(intereses);
        $('total-display').textContent = money(total);
        $('tasa-resumen').textContent = tasa.toFixed(1) + '%';
        $('plazo-resumen').textContent = n + (n === 1 ? ' mes' : ' meses');
        $('wa-monto').value = money(P);

        const rows = [];
        let saldo = P;

        for (let k = 1; k <= n; k++) {
            const interesMes = saldo * i;
            let amortizacion = cuota - interesMes;
            let pago = cuota;

            if (k === n) {
                amortizacion = saldo;
                pago = amortizacion + interesMes;
            }

            saldo = Math.max(0, saldo - amortizacion);

            rows.push({
                cuota: k,
                pago,
                interes: interesMes,
                capital: amortizacion,
                saldo
            });
        }

        $('amort-body').innerHTML = rows.map(r => `
            <tr>
                <td>${r.cuota}</td>
                <td>${money(r.pago)}</td>
                <td>${money(r.interes)}</td>
                <td>${money(r.capital)}</td>
                <td>${money(r.saldo)}</td>
            </tr>
        `).join('');

        actualizarGraficos(P, intereses, rows);
    }

    function actualizarGraficos(P, intereses, rows) {
        if (typeof Chart === 'undefined') return;

        if (costChart) costChart.destroy();
        if (balanceChart) balanceChart.destroy();

        const costCtx = $('cost-chart').getContext('2d');
        costChart = new Chart(costCtx, {
            type: 'doughnut',
            data: {
                labels: ['Capital', 'Intereses'],
                datasets: [{
                    data: [P, Math.max(0, intereses)],
                    backgroundColor: ['#2e9e43', '#f26e22'],
                    borderWidth: 0,
                    hoverOffset: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '68%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { usePointStyle: true, padding: 18, font: { size: 12 } }
                    }
                }
            }
        });

        const balanceCtx = $('balance-chart').getContext('2d');
        balanceChart = new Chart(balanceCtx, {
            type: 'line',
            data: {
                labels: ['Inicio', ...rows.map(r => 'C' + r.cuota)],
                datasets: [{
                    label: 'Saldo',
                    data: [P, ...rows.map(r => r.saldo)],
                    borderColor: '#2e9e43',
                    backgroundColor: 'rgba(46,158,67,.10)',
                    fill: true,
                    tension: .35,
                    pointRadius: 2,
                    pointHoverRadius: 5,
                    borderWidth: 3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: value => 'S/ ' + Number(value).toLocaleString('es-PE')
                        },
                        grid: { color: '#edf1ee' }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { maxTicksLimit: 8 }
                    }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });
    }

    $('toggle-amort').addEventListener('click', function () {
        const box = $('amort-container');
        const visible = !box.classList.contains('hidden');
        box.classList.toggle('hidden');
        this.innerHTML = visible
            ? '<i class="fas fa-table mr-2"></i> Ver tabla'
            : '<i class="fas fa-chevron-up mr-2"></i> Ocultar tabla';
    });

    $('wa-form').addEventListener('submit', function (e) {
        e.preventDefault();
        const nombre = $('wa-nombre').value.trim();
        const negocio = $('wa-negocio').value.trim();
        const monto = $('monto-input').value;
        const plazo = $('plazo-input').value;
        const tasa = $('tasa-input').value;
        const cuota = $('cuota-display').textContent;
        const oficina = $('wa-oficina').value;

        const mensaje = `Hola, deseo solicitar información sobre: ${encodeURIComponent(productoSeleccionado)}.%0A%0A` +
            `Nombre: ${encodeURIComponent(nombre)}%0A` +
            `Ocupación/Negocio: ${encodeURIComponent(negocio)}%0A` +
            `Monto: S/ ${encodeURIComponent(Number(monto).toLocaleString('es-PE'))}%0A` +
            `Plazo: ${encodeURIComponent(plazo)} meses%0A` +
            `Tasa mensual: ${encodeURIComponent(tasa)}%%0A` +
            `Cuota referencial: ${encodeURIComponent(cuota)}%0A` +
            `Oficina: ${encodeURIComponent(oficina)}`;

        window.open('https://wa.me/51968876759?text=' + mensaje, '_blank');
    });

    const btnReq = $('requisitosBtn');
    const panel = $('panelRequisitos');
    const cerrar = $('cerrarPanel');

    if (btnReq && panel && cerrar) {
        btnReq.addEventListener('click', () => panel.classList.remove('hidden'));
        cerrar.addEventListener('click', () => panel.classList.add('hidden'));
        panel.addEventListener('click', (e) => {
            if (e.target === panel) panel.classList.add('hidden');
        });
    }

    calcular();
});
</script>

<?php include 'footer.php'; ?>