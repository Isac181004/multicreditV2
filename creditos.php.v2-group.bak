            <span class="inline-flex items-center gap-2 bg-green-50 text-brand-green px-4 py-2 rounded-full text-xs font-extrabold uppercase tracking-wider">
                <i class="fas fa-calculator"></i> Simulador financiero
            </span>
            <h2 class="text-3xl md:text-4xl font-extrabold text-gray-800 mt-4">Calcula tu crédito</h2>
            <p class="text-gray-500 mt-3">
                Ajusta el monto, plazo y tasa para conocer una cuota referencial y visualizar cómo evoluciona tu crédito.
            </p>
        </div>

        <div class="simulator-shell bg-white">
            <div class="grid grid-cols-1 lg:grid-cols-12">

                <!-- CONTROLES -->
                <div class="lg:col-span-4 p-6 md:p-8 border-b lg:border-b-0 lg:border-r border-gray-200">
                    <div class="flex items-center justify-between mb-7">
                        <div>
                            <span class="text-[11px] uppercase tracking-widest text-gray-400 font-bold">Paso 1</span>
                            <h3 class="text-xl font-extrabold text-gray-800 mt-1">Ajusta tu crédito</h3>
                        </div>
                        <div class="w-11 h-11 rounded-xl bg-green-50 text-brand-green flex items-center justify-center">
                            <i class="fas fa-sliders-h"></i>
                        </div>
                    </div>

                    <div class="space-y-7">
                        <div>
                            <div class="flex justify-between items-center mb-3">
                                <label class="sim-label">Monto a solicitar</label>
                                <div class="flex items-center gap-1">
                                    <span class="text-xs font-bold text-gray-400">S/</span>
                                    <input type="number" id="monto-input" value="5000" min="500" max="50000" step="100"
                                           class="sim-number w-28 text-right">
                                </div>
                            </div>
                            <input type="range" id="monto-slider" min="500" max="50000" step="100" value="5000" class="sim-range">
                            <div class="flex justify-between text-[10px] text-gray-400 mt-2"><span>S/ 500</span><span>S/ 50,000</span></div>
                        </div>

                        <div>
                            <div class="flex justify-between items-center mb-3">
                                <label class="sim-label">Plazo de pago</label>
                                <div class="flex items-center gap-1">
                                    <input type="number" id="plazo-input" value="12" min="1" max="36"
                                           class="sim-number w-20 text-right">
                                    <span class="text-xs font-bold text-gray-400">meses</span>
                                </div>
                            </div>
                            <input type="range" id="plazo-slider" min="1" max="36" value="12" class="sim-range">
                            <div class="flex justify-between text-[10px] text-gray-400 mt-2"><span>1 mes</span><span>36 meses</span></div>
                        </div>

                        <div>
                            <div class="flex justify-between items-center mb-3">
                                <label class="sim-label">Tasa efectiva mensual</label>
                                <div class="flex items-center gap-1">
                                    <input type="number" id="tasa-input" value="3.6" min="3.0" max="4.0" step="0.1"
                                           class="sim-number w-20 text-right">
                                    <span class="text-xs font-bold text-gray-400">%</span>
                                </div>
                            </div>
                            <input type="range" id="tasa-slider" min="3.0" max="4.0" step="0.1" value="3.6" class="sim-range">
                            <div class="flex justify-between text-[10px] text-gray-400 mt-2"><span>3.0%</span><span>4.0%</span></div>
                        </div>

                        <div class="bg-gray-50 border border-gray-100 rounded-2xl p-4">
                            <div class="flex items-start gap-3">
                                <div class="w-9 h-9 rounded-lg bg-white text-brand-green flex items-center justify-center shadow-sm">
                                    <i class="fas fa-info-circle"></i>
                                </div>
                                <div>
                                    <p class="text-xs font-bold text-gray-700">Simulación referencial</p>
                                    <p class="text-[11px] leading-relaxed text-gray-500 mt-1">El resultado puede variar según evaluación, condiciones y políticas de crédito.</p>
                                </div>
                            </div>
                        </div>

                        <button id="requisitosBtn" class="w-full bg-gray-800 hover:bg-gray-900 text-white text-xs font-bold py-3 px-4 rounded-xl transition shadow flex items-center justify-center">
                            <i class="fas fa-file-alt mr-2"></i> VER REQUISITOS GENERALES
                        </button>
                    </div>
                </div>

                <!-- RESULTADO -->
                <div class="lg:col-span-4 p-6 md:p-8 sim-result">
                    <div class="flex items-center justify-between mb-7">
                        <div>
                            <span class="text-[11px] uppercase tracking-widest sim-muted font-bold">Paso 2</span>
                            <h3 class="text-xl font-extrabold text-white mt-1">Tu resultado</h3>
                        </div>
                        <div class="w-11 h-11 rounded-xl bg-white/10 border border-white/10 flex items-center justify-center">
                            <i class="fas fa-chart-line"></i>
                        </div>
                    </div>

                    <div class="sim-result-box p-6 text-center">
                        <span class="text-[11px] uppercase tracking-widest sim-muted font-bold">Cuota mensual fija</span>
                        <div id="cuota-display" class="sim-main-number mt-3">S/ 0.00</div>
                        <p class="text-[11px] sim-muted mt-3">Estimación de cuota mensual</p>
                    </div>

                    <div class="mt-5">
                        <div class="sim-result-row">
                            <span class="text-sm sim-muted">Capital solicitado</span>
                            <strong id="capital-display" class="text-base">S/ 0.00</strong>
                        </div>
                        <div class="sim-result-row">
                            <span class="text-sm sim-muted">Intereses aproximados</span>
                            <strong id="interes-display" class="text-base">S/ 0.00</strong>
                        </div>
                        <div class="sim-result-row">
                            <span class="text-sm font-bold">Total a pagar</span>
                            <strong id="total-display" class="text-lg">S/ 0.00</strong>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3 mt-6">
                        <div class="bg-white/10 rounded-xl p-3 border border-white/10">
                            <span class="text-[10px] sim-muted uppercase font-bold block">Tasa mensual</span>
                            <strong id="tasa-resumen" class="text-sm block mt-1">3.6%</strong>
                        </div>
                        <div class="bg-white/10 rounded-xl p-3 border border-white/10">
                            <span class="text-[10px] sim-muted uppercase font-bold block">Plazo</span>
                            <strong id="plazo-resumen" class="text-sm block mt-1">12 meses</strong>
                        </div>
                    </div>
                </div>

                <!-- SOLICITUD -->
                <div class="lg:col-span-4 p-6 md:p-8">
                    <div class="flex items-center justify-between mb-7">
                        <div>
                            <span class="text-[11px] uppercase tracking-widest text-gray-400 font-bold">Paso 3</span>
                            <h3 class="text-xl font-extrabold text-gray-800 mt-1">Solicita tu crédito</h3>
                        </div>
                        <div class="w-11 h-11 rounded-xl bg-green-50 text-green-500 flex items-center justify-center">
                            <i class="fab fa-whatsapp text-xl"></i>
                        </div>
                    </div>

                    <form id="wa-form" class="space-y-4">
                        <div>
                            <label class="text-xs font-bold text-gray-600 block mb-1.5">Nombres y Apellidos</label>
                            <input type="text" id="wa-nombre" required placeholder="Ej. Juan Pérez"
                                   class="w-full border border-gray-200 rounded-xl px-3.5 py-3 text-sm focus:outline-none focus:border-brand-green focus:ring-4 focus:ring-green-50">
                        </div>

                        <div>
                            <label class="text-xs font-bold text-gray-600 block mb-1.5">¿Tienes un negocio? / Ocupación</label>
                            <input type="text" id="wa-negocio" required placeholder="Ej. Tienda de abarrotes"
                                   class="w-full border border-gray-200 rounded-xl px-3.5 py-3 text-sm focus:outline-none focus:border-brand-green focus:ring-4 focus:ring-green-50">
                        </div>

                        <div>
                            <label class="text-xs font-bold text-gray-600 block mb-1.5">Monto de validación</label>
                            <input type="text" id="wa-monto" readonly
                                   class="w-full border border-gray-200 bg-gray-50 rounded-xl px-3.5 py-3 text-sm font-extrabold text-brand-green">
                        </div>

                        <div>
                            <label class="text-xs font-bold text-gray-600 block mb-1.5">Oficina más cercana</label>
                            <select id="wa-oficina" required
                                    class="w-full border border-gray-200 rounded-xl px-3.5 py-3 text-sm bg-white focus:outline-none focus:border-brand-green focus:ring-4 focus:ring-green-50">
                                <option value="Cajamarca">Sede Principal - Cajamarca</option>
                                <option value="Huamachuco">Agencia Huamachuco</option>
                                <option value="Cajabamba">Agencia Cajabamba</option>
                                <option value="San Marcos">Agencia San Marcos</option>
                            </select>
                        </div>

                        <button type="submit" class="sim-whatsapp w-full text-white font-bold py-3.5 px-4 rounded-xl transition uppercase text-xs tracking-wider flex items-center justify-center mt-2">
                            <i class="fab fa-whatsapp text-lg mr-2"></i> Enviar a un asesor
                        </button>
                    </form>
                </div>
            </div>

            <!-- GRÁFICOS -->
            <div class="p-6 md:p-8 bg-gray-50 border-t border-gray-200">
                <div class="flex items-center justify-between mb-5">
                    <div>
                        <span class="text-[11px] uppercase tracking-widest text-gray-400 font-bold">Análisis</span>
                        <h3 class="text-xl font-extrabold text-gray-800 mt-1">Conoce mejor tu crédito</h3>
                    </div>
                    <div class="hidden sm:flex items-center gap-2 text-xs text-gray-400">
                        <i class="fas fa-chart-pie text-brand-green"></i> Visualización referencial
                    </div>
                </div>

                <div class="grid grid-cols-1 xl:grid-cols-2 gap-5">
                    <div class="sim-chart-card">
                        <div class="flex justify-between items-start">
                            <div>
                                <h4 class="font-bold text-gray-800">Distribución del pago</h4>
                                <p class="text-xs text-gray-400 mt-1">Capital frente a intereses</p>
                            </div>
                            <span class="w-9 h-9 rounded-lg bg-green-50 text-brand-green flex items-center justify-center"><i class="fas fa-chart-pie"></i></span>
                        </div>
                        <div class="sim-chart-wrap mt-3">
                            <canvas id="cost-chart"></canvas>
                        </div>
                    </div>

                    <div class="sim-chart-card">
                        <div class="flex justify-between items-start">
                            <div>
                                <h4 class="font-bold text-gray-800">Evolución del saldo</h4>
                                <p class="text-xs text-gray-400 mt-1">Reducción estimada de la deuda</p>
                            </div>
                            <span class="w-9 h-9 rounded-lg bg-orange-50 text-brand-orange flex items-center justify-center"><i class="fas fa-chart-line"></i></span>
                        </div>
                        <div class="sim-chart-wrap mt-3">
                            <canvas id="balance-chart"></canvas>
                        </div>
                    </div>
                </div>

                <!-- TABLA -->
                <div class="sim-card mt-5 overflow-hidden">
                    <div class="p-5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                        <div>
                            <h4 class="font-extrabold text-gray-800">Tabla de amortización</h4>
                            <p class="text-xs text-gray-400 mt-1">Detalle estimado de cada cuota.</p>
                        </div>
                        <button id="toggle-amort" type="button" class="sim-toggle px-4 py-2 rounded-xl text-xs font-bold transition">
                            <i class="fas fa-table mr-2"></i> Ver tabla
                        </button>
                    </div>

                    <div id="amort-container" class="hidden border-t border-gray-100">
                        <div class="overflow-x-auto">
